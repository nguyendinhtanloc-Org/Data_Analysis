# Thông tin đăng nhập cho Postgres nội bộ của đồ án.
# LƯU Ý BẢNG: Đổi mật khẩu thành giá trị mạnh TRƯỚC khi chạy trên máy có dữ liệu thực.
# Mật khẩu yếu chỉ dùng cho local dev; không sử dụng cho production.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=adventureworks

# Host và port dùng từ máy local.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Cấu hình cho Metabase - LƯU Ý cũng phải đổi mật khẩu.
METABASE_DB_TYPE=postgres
METABASE_DB_HOST=postgres
METABASE_DB_PORT=5432
METABASE_DB_USER=postgres
METABASE_DB_PASS=change-me-strong-password
METABASE_DB_DBNAME=metabase_db
