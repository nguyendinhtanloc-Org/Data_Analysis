# PostgreSQL (Data Warehouse + Metabase metadata)
POSTGRES_USER=dw_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_64ee8a2b
POSTGRES_DB=adventureworks_dw
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# MSSQL (AdventureWorks OLTP source)
MSSQL_USER=sa
MSSQL_PASSWORD=CHANGE_ME_MSSQL_STRONG_89f1c4d7
MSSQL_HOST=localhost
MSSQL_PORT=1433

# Metabase BI
METABASE_DB_TYPE=postgres
METABASE_DB_HOST=postgres
METABASE_DB_PORT=5432
METABASE_DB_USER=dw_admin
METABASE_DB_PASS=CHANGE_ME_STRONG_PASSWORD_64ee8a2b
METABASE_DB_DBNAME=metabase_db

# ETL Source (MSSQL)
ETL_SOURCE_HOST=mssql
ETL_SOURCE_PORT=1433
ETL_SOURCE_DATABASE=AdventureWorks2022
ETL_SOURCE_USER=sa
ETL_SOURCE_PASSWORD=CHANGE_ME_MSSQL_STRONG_89f1c4d7

# ETL Target (PostgreSQL)
ETL_TARGET_HOST=postgres
ETL_TARGET_PORT=5432
ETL_TARGET_DATABASE=adventureworks_dw
