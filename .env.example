# PostgreSQL dùng làm Data Warehouse và lưu metadata nội bộ.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=adventureworks_dw
POSTGRES_HOST=localhost
POSTGRES_PORT=5432


# SQL Server chứa dữ liệu nguồn AdventureWorks.
MSSQL_USER=sa
MSSQL_PASSWORD=YourStrong@Passw0rd
MSSQL_HOST=localhost
MSSQL_PORT=1433


# Cấu hình Metabase.
METABASE_DB_TYPE=postgres
METABASE_DB_HOST=postgres
METABASE_DB_PORT=5432
METABASE_DB_USER=postgres
METABASE_DB_PASS=change-me-strong-password
METABASE_DB_DBNAME=metabase_db


# Cấu hình ETL.
ETL_SOURCE_HOST=mssql
ETL_SOURCE_PORT=1433
ETL_SOURCE_DATABASE=AdventureWorks2022
ETL_SOURCE_USER=sa
ETL_SOURCE_PASSWORD=YourStrong@Passw0rd

ETL_TARGET_HOST=postgres
ETL_TARGET_PORT=5432
ETL_TARGET_DATABASE=adventureworks_dw
ETL_TARGET_USER=postgres
ETL_TARGET_PASSWORD=change-me-strong-password